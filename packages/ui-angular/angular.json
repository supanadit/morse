{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "6e61a357-7c33-4757-a9ec-f0fcfc7df619"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ui-angular": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "morse",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "allowedCommonJsDependencies": [
              "@morse/protocol",
              "@morse/ui-runtime",
              // xterm.js ships CommonJS only; it is lazy-loaded, so its size and
              // format never touch the initial bundle.
              "@xterm/xterm",
              "@xterm/addon-fit",
              "@xterm/addon-webgl"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  // ~1 MB raw (~230 kB over the wire) today: markdown, highlight.js,
                  // DOMPurify, anime.js and Angular are all in the initial bundle; the
                  // code-split editors (prompt templates) stay out of it. The ceiling
                  // tracks the app's growth (1 MB was set when it was ~600 kB) and is
                  // meant to warn about growth, not to freeze the size.
                  "maximumWarning": "750kB",
                  "maximumError": "1.05MB"
                },
                {
                  "type": "anyComponentStyle",
                  // The transcript's own stylesheet is the largest at ~10.6 kB.
                  "maximumWarning": "12kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.mjs",
            // Workspace libraries are linked packages: prebundling them makes a
            // long-running dev server (and the browser) serve a stale copy after
            // they are rebuilt. Excluding them keeps every reload authoritative.
            "prebundle": {
              "exclude": ["@morse/protocol", "@morse/ui-runtime"]
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "ui-angular:build:production"
            },
            "development": {
              "buildTarget": "ui-angular:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
