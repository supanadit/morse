{
  "name": "@morse/system",
  "version": "0.27.0",
  "private": true,
  "type": "module",
  "description": "Morse itself: its own domain, its session index and its use cases. Pure TypeScript: no vscode, no NestJS, no child_process, no I/O.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@morse/agent": "*",
    "@morse/protocol": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
