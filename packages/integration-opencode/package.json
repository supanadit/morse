{
  "name": "@morse/integration-opencode",
  "version": "0.26.0",
  "private": true,
  "type": "module",
  "description": "Driven adapter: drives an OpenCode server (v2 HTTP API) and implements the harness contract.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@morse/agent": "*",
    "@morse/protocol": "*",
    "@morse/system": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
