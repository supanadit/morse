{
  "name": "@morse/ui-runtime",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Framework-free frontend core: host transports (VS Code postMessage, WebSocket, in-memory mock) and the Morse client that reduces wire messages into view state.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@morse/protocol": "*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
