{
  "name": "@morse/ui-runtime",
  "version": "0.22.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "description": "Framework-free frontend core: host transports (VS Code postMessage, WebSocket, in-memory mock) and the Morse client that reduces wire messages into view state.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@morse/protocol": "*",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "jsdom": "^30.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
