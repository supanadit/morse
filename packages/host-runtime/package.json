{
  "name": "@morse/host-runtime",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Host-side glue shared by every Morse host: transcript projection and the client-message session controller. Technology-agnostic (clean-architecture R4).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@morse/protocol": "*"
  },
  "devDependencies": {
    "@morse/core": "*",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
